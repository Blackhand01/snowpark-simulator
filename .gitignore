# Pubblicazione esplicita: i nuovi file nella radice restano locali.
/*
!/.gitignore
!/README.md
!/ASSET_CREDITS.md
!/run*.py
!/config.toml
!/animation.toml
!/athlete_look.toml
!/boardslide.toml
!/boardslide_synced.toml
!/capture*.toml
!/cork*.toml
!/double_cork_rail.toml
!/p2_config.toml
!/rail_slide.toml
!/refine_config.toml
!/snow_visibility.toml
!/conditions.json
!/reference_timing.json
!/trick_catalog.json
!/scripts/
!/configs/
!/assets/
!/docs/

# Documentazione interna e riferimenti personali: pubblicare solo le immagini scelte.
/docs/*
!/docs/images/
/docs/images/*
!/docs/images/snowpark-render.png
!/docs/images/boardslide.gif
!/docs/images/boardslide-sequence.jpg
!/docs/images/render-conditions.png

# Cache, ambienti locali, credenziali e backup, anche nelle directory ammesse.
**/__pycache__/
*.py[cod]
.DS_Store
._*
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
**/target/
**/.tools/
*.blend
*.blend[0-9]
*.log
