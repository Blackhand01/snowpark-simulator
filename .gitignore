# Source, configurations, notebooks, design dossiers, prompts and compact
# reports are versionable by default. Exclude local work by purpose below.
/outputs/
/.local/
/references/
/.tools/
/target/

# Local preservation inventories duplicate the working-tree state. Keep design
# documents, review summaries, source references and validation results in Git.
/docs/**/preservation-before.json
/docs/**/preservation-review.json
/docs/**/concurrent-player-snapshot.json
/docs/**/revisions/*/before.json

# Local runs, environments, secrets and generated binaries.
**/__pycache__/
*.py[cod]
.DS_Store
._*
.env
.env.*
!.env.example
.envrc
credentials.json
token.json
*.pem
*.key
*.p12
*.pfx
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/
.ipynb_checkpoints/
node_modules/
build/
dist/
*.egg-info/
**/target/
**/.tools/
*.blend
*.blend[0-9]*
*.log

# Downloaded archives, model weights and generated reconstruction data.
# Curated documentation images and redistributable textures remain versionable.
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.pt
*.pth
*.ckpt
