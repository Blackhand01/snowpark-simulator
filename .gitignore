# Only source, documented configurations and selected public assets enter Git.
/*
!/.gitignore
!/README.md
!/ASSET_CREDITS.md
!/pyproject.toml
!/snowpark_simulator/
!/scripts/
!/tools/
!/configs/
!/tests/
!/.github/
!/assets/
!/docs/

# Keep private references and chronological experiment reports local.
/docs/*
!/docs/images/
!/docs/architecture.md
!/docs/development.md
/docs/images/*
!/docs/images/snowpark-overview.png
!/docs/images/boardslide-preview.gif

# Local runs, environments, secrets and generated binaries.
**/__pycache__/
*.py[cod]
.DS_Store
._*
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
**/target/
**/.tools/
*.blend
*.blend[0-9]
*.log
